{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SessionShare",
  "mainBinaryName": "SessionShare",
  "version": "0.1.0",
  "identifier": "com.sessionshare.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SessionShare — Claude Code Sync",
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "wix": {
        "upgradeCode": "1312e3c5-44b6-5728-ac51-a030b80f7fe7"
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
